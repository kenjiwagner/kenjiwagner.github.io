---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, githubProfileUrl } from '../site.config';
import { resume } from '../lib/resume';
---
<Base title="Resume" description={`Resume of ${site.name}, ${site.role}.`}>
  <div class="container narrow">
    <header class="head">
      <div>
        <h1>{site.name}</h1>
        <p class="sub">{site.role} · {site.location}</p>
        <p class="contact">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.linkedin}>LinkedIn</a>
          <a href={githubProfileUrl}>GitHub</a>
        </p>
      </div>
      <a class="btn primary no-print" href={site.resumePdf} download><Icon name="download" /> Download PDF</a>
    </header>

    <section>
      <h2>Experience</h2>
      {resume.experience.map((job) => (
        <div class="item">
          <div class="row"><h3>{job.org}</h3><span class="date mono">{job.period}</span></div>
          <div class="row sub2">
            <span>{job.roles.map((r) => r.period && job.roles.length > 1 ? `${r.title} (${r.period})` : r.title).join(' | ')}</span>
            <span>{job.location}</span>
          </div>
          <ul>{job.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Education</h2>
      {resume.education.map((ed) => (
        <div class="item">
          <div class="row"><h3>{ed.school}</h3><span class="date mono">{ed.period}</span></div>
          <div class="row sub2"><span>{ed.degree}</span><span>{ed.location}</span></div>
        </div>
      ))}
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {Object.entries(resume.skills).map(([group, items]) => (
          <><dt>{group}</dt><dd>{items.join(', ')}</dd></>
        ))}
      </dl>
    </section>

    <section>
      <h2>Leadership</h2>
      {resume.leadership.map((l) => (
        <div class="item">
          <div class="row"><h3>{l.org}</h3><span class="date mono">{l.period}</span></div>
          <div class="row sub2"><span>{l.title}</span><span>{l.location}</span></div>
          <ul>{l.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))}
    </section>

    <p class="see-projects no-print">Looking for project write-ups? <a href="/projects">See all projects →</a></p>
  </div>
</Base>

<style>
  .narrow { max-width: 820px; padding-top: 48px; }
  .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; padding-bottom: 8px; }
  h1 { font-size: 2.3rem; }
  .sub { color: var(--text-2); margin: 6px 0 8px; }
  .contact { display: flex; flex-wrap: wrap; gap: 16px; font-size: 0.92rem; margin: 0; }
  section { padding: 28px 0 0; }
  h2 {
    font-size: 0.8rem; font-family: 'JetBrains Mono', monospace; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);
    padding-bottom: 8px; border-bottom: 1px solid var(--border); margin-bottom: 18px;
  }
  .item { margin-bottom: 22px; }
  .row { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  h3 { font-size: 1.05rem; }
  .date { color: var(--muted); font-size: 0.8rem; padding-top: 3px; }
  .sub2 { color: var(--text-2); font-size: 0.92rem; font-style: italic; }
  ul { margin: 8px 0 0; padding-left: 1.2em; color: var(--text-2); font-size: 0.95rem; }
  li { margin: 4px 0; }
  li::marker { color: var(--accent); }
  .skills { display: grid; grid-template-columns: 160px 1fr; gap: 8px 16px; margin: 0; font-size: 0.95rem; }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--text-2); }
  .see-projects { margin-top: 32px; color: var(--muted); }
  @media (max-width: 560px) { .skills { grid-template-columns: 1fr; } dd { margin-bottom: 8px; } }

  @media print {
    :global(.site-header), :global(.site-footer), .no-print { display: none !important; }
    :global(body) { background: #fff !important; color: #000; font-size: 11pt; }
  }
</style>
