---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
// Filter chips: tags used by more than one project, most common first.
const counts = new Map<string, number>();
projects.flatMap((p) => p.tags).forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1));
const filters = [...counts].filter(([, n]) => n > 1).sort((a, b) => b[1] - a[1]).map(([t]) => t);
---
<Base title="Projects" description="Projects in AI, machine learning, data engineering, and analytics.">
  <section>
    <div class="container">
      <p class="eyebrow">Work</p>
      <h1>Projects</h1>
      <p class="lede">Machine learning, data engineering, and analytics, from course work to production. New GitHub repos tagged <code class="mono">portfolio</code> show up here automatically.</p>

      {filters.length > 0 && (
        <div class="filters" role="group" aria-label="Filter by tag">
          <button class="active" data-filter="">All</button>
          {filters.map((t) => <button data-filter={t}>{t}</button>)}
        </div>
      )}

      <div class="grid" id="grid">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cards = document.querySelectorAll<HTMLElement>('#grid > [data-tags]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.classList.toggle('active', b === btn));
      cards.forEach((c) => {
        c.hidden = Boolean(f) && !c.dataset.tags!.split('|').includes(f!);
      });
    }),
  );
</script>

<style>
  h1 { font-size: 2.4rem; }
  .lede { color: var(--text-2); max-width: 620px; margin: 12px 0 28px; }
  .lede code { font-size: 0.85em; background: var(--surface-2); padding: 2px 6px; border-radius: 5px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .filters button {
    font: inherit; font-size: 0.85rem; cursor: pointer;
    padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--border); background: var(--surface); color: var(--text-2);
  }
  .filters button:hover { border-color: var(--accent); color: var(--text); }
  .filters button.active { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .grid > [hidden] { display: none; }
</style>
