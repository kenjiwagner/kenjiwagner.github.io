---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getProjects, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project: p } = Astro.props as { project: Project };
const Content = p.entry && p.entry.body?.trim() ? (await render(p.entry)).Content : null;
const updated = p.repo
  ? new Date(p.repo.pushedAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  : null;
---
<Base title={p.title} description={p.summary}>
  <article class="container narrow">
    <a href="/projects" class="back">← All projects</a>
    <header>
      {p.period && <p class="eyebrow">{p.period}</p>}
      <h1>{p.title}</h1>
      <p class="summary">{p.summary}</p>
      <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
      {(p.repo || p.demo) && (
        <div class="actions">
          {p.demo && <a class="btn primary" href={p.demo}><Icon name="external" /> Live demo</a>}
          {p.repo && <a class="btn" href={p.repo.url}><Icon name="github" /> View code</a>}
          {p.repo && (
            <span class="stats mono">
              {p.repo.language && <span>{p.repo.language}</span>}
              <span><Icon name="star" size={12} /> {p.repo.stars}</span>
              <span>Updated {updated}</span>
            </span>
          )}
        </div>
      )}
    </header>

    {p.highlights.length > 0 && (
      <ul class="card highlights">
        {p.highlights.map((h) => <li>{h}</li>)}
      </ul>
    )}

    <div class="prose">
      {Content ? <Content /> : p.readmeHtml ? <Fragment set:html={p.readmeHtml} /> : null}
    </div>
  </article>
</Base>

<style>
  .narrow { max-width: 760px; padding-top: 40px; padding-bottom: 40px; }
  .back { display: inline-block; font-size: 0.9rem; margin-bottom: 28px; color: var(--muted); }
  .back:hover { color: var(--text); }
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); }
  .summary { font-size: 1.12rem; color: var(--text-2); margin: 14px 0 16px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 22px; }
  .stats { display: flex; gap: 14px; color: var(--muted); font-size: 0.78rem; margin-left: 4px; }
  .stats span { display: inline-flex; align-items: center; gap: 4px; }
  .highlights { margin: 32px 0 8px; padding: 18px 22px 18px 40px; color: var(--text-2); }
  .highlights li { margin: 4px 0; }
  .highlights li::marker { color: var(--accent); }
  .prose { margin-top: 24px; }
</style>
