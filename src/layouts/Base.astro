---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, githubProfileUrl } from '../site.config';

interface Props { title?: string; description?: string }
const { title, description = site.intro } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a href="/" class="brand mono">kenji<span>.</span>wagner</a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class:list={{ active: isActive(n.href) }} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode">
            <span class="icon-sun"><Icon name="sun" /></span>
            <span class="icon-moon"><Icon name="moon" /></span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <div class="links">
          <a href={githubProfileUrl} aria-label="GitHub"><Icon name="github" size={18} /></a>
          <a href={site.linkedin} aria-label="LinkedIn"><Icon name="linkedin" size={18} /></a>
          <a href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" size={18} /></a>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .brand { color: var(--text); font-weight: 500; font-size: 0.95rem; }
  .brand span { color: var(--accent); }
  .brand:hover { text-decoration: none; }
  nav { display: flex; align-items: center; gap: 4px; }
  nav a {
    color: var(--text-2); font-size: 0.92rem; font-weight: 500;
    padding: 6px 10px; border-radius: 8px;
  }
  nav a:hover { color: var(--text); text-decoration: none; background: var(--surface-2); }
  nav a.active { color: var(--text); }
  #theme-toggle {
    display: grid; place-items: center;
    width: 34px; height: 34px; margin-left: 6px;
    border: 1px solid var(--border); border-radius: 8px;
    background: var(--surface); color: var(--text-2); cursor: pointer;
  }
  #theme-toggle:hover { color: var(--text); border-color: var(--accent); }
  .icon-sun { display: none; }
  :global(:root[data-theme='dark']) .icon-sun { display: block; }
  :global(:root[data-theme='dark']) .icon-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun { display: block; }
    :global(:root:not([data-theme='light'])) .icon-moon { display: none; }
  }
  .icon-sun, .icon-moon { line-height: 0; }

  .site-footer { border-top: 1px solid var(--border); margin-top: 40px; }
  .foot { display: flex; justify-content: space-between; align-items: center; padding: 28px 20px; color: var(--muted); font-size: 0.88rem; }
  .links { display: flex; gap: 14px; }
  .links a { color: var(--muted); }
  .links a:hover { color: var(--text); }

  @media (max-width: 520px) {
    .brand { font-size: 0.85rem; }
    nav a { padding: 6px 7px; font-size: 0.88rem; }
  }
</style>
