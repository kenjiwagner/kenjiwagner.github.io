---
import Icon from './Icon.astro';
import type { Project } from '../lib/projects';

interface Props { project: Project }
const { project: p } = Astro.props;
---
<a href={`/projects/${p.slug}`} class="card project" data-tags={p.tags.join('|')}>
  <div class="meta mono">
    <span>{p.period ?? p.date.getFullYear()}</span>
    {p.repo && (
      <span class="gh"><Icon name="github" size={13} /> {p.repo.stars > 0 && <><Icon name="star" size={12} /> {p.repo.stars}</>}</span>
    )}
  </div>
  <h3>{p.title}</h3>
  <p>{p.summary}</p>
  <div class="tags">
    {p.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
  </div>
  <span class="more">Read more <Icon name="arrow" size={14} /></span>
</a>

<style>
  .project {
    display: flex; flex-direction: column; gap: 10px;
    padding: 22px; color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }
  .project:hover { text-decoration: none; border-color: var(--accent); transform: translateY(-2px); }
  .meta { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.75rem; }
  .gh { display: inline-flex; align-items: center; gap: 4px; }
  h3 { font-size: 1.08rem; }
  p { color: var(--text-2); font-size: 0.93rem; margin: 0; flex: 1; }
  .more { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-size: 0.88rem; font-weight: 500; margin-top: 4px; }
  .more :global(svg) { transition: transform 0.15s; }
  .project:hover .more :global(svg) { transform: translateX(3px); }
</style>
